# ==============================================================================
# BUKU TAMU DIGITAL - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi '.env' dan sesuaikan nilainya dengan environment Anda.
# PENTING: Jangan commit file '.env' berisi data rahasia/asli ke repository Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODE LINGKUNGAN (PILIH: 'local' ATAU 'production')
# ------------------------------------------------------------------------------
# Default jika kosong adalah 'production' (Secure by Default).
# - 'local'     : Untuk pengujian di komputer lokal via HTTP (http://127.0.0.1:8000)
# - 'production': Untuk server live via HTTPS (wajib sertifikat SSL, HSTS, secure cookies)
APP_ENV=local

# ------------------------------------------------------------------------------
# 2. KEAMANAN INTI DJANGO
# ------------------------------------------------------------------------------
# SECRET_KEY:
# - Di local: boleh memakai string acak dev.
# - Di production: WAJIB diisi dengan random key 50+ karakter yang kuat & rahasia.
SECRET_KEY=ganti-dengan-secret-key-acak-yang-panjang-dan-kuat-minimal-50-karakter

# DEBUG:
# - Di local: boleh 'True' atau 'False'
# - Di production: SELALU terkunci otomatis menjadi 'False' demi keamanan.
DEBUG=True

# ALLOWED_HOSTS:
# - Di local: otomatis mengizinkan localhost, 127.0.0.1, testserver.
# - Di production: WAJIB diisi domain server Anda, dipisahkan koma.
# Contoh production: bukutamu.diskominfosantik.bekasikab.go.id,bukutamu.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF_TRUSTED_ORIGINS:
# - Di local: otomatis mengizinkan http://127.0.0.1, http://localhost.
# - Di production: WAJIB menyertakan skema https:// domain Anda.
# Contoh production: https://bukutamu.diskominfosantik.bekasikab.go.id
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# REVERSE PROXY SSL (RENDER / KOYEB / RAILWAY / NGINX):
# Di local: biarkan 'False'.
# Di production PaaS (Render, Koyeb, Railway): WAJIB set ke 'True'
# agar Django mendeteksi header 'X-Forwarded-Proto: https' dari proxy platform
# dan mencegah terjadinya loop redirect HTTPS.
USE_PROXY_SSL_HEADER=False

# HSTS SECONDS (Hanya berlaku di production):
# Nilai awal 3600 (1 jam). Naikkan ke 31536000 (1 tahun) setelah domain stabil.
SECURE_HSTS_SECONDS=3600

# ------------------------------------------------------------------------------
# 3. KONEKSI DATABASE MYSQL
# ------------------------------------------------------------------------------
DB_NAME=bukudigital
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------------------------------------------
# 4. WEBSOCKET & CHANNELS (REDIS)
# ------------------------------------------------------------------------------
# Jika kosong, aplikasi akan memakai InMemoryChannelLayer (cocok untuk local dev).
# Di production cluster, isi dengan connection string Redis Anda.
REDIS_URL=

# ------------------------------------------------------------------------------
# 5. PENYIMPANAN BERKAS MEDIA (CLOUDINARY)
# ------------------------------------------------------------------------------
# Jika kosong, file media disimpan di folder media/ lokal (cocok untuk mode local).
# Di production PaaS (Render/Railway/Koyeb yang ephemeral), WAJIB diisi URL Cloudinary.
# Format: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
# (Dapat disalin langsung dari Cloudinary Dashboard -> API Environment variable)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFIKASI (SMTP GMAIL)
# ------------------------------------------------------------------------------
EMAIL_HOST_USER=email-admin@domain.com
EMAIL_HOST_PASSWORD=app-password-gmail-16-karakter

# ------------------------------------------------------------------------------
# 7. INTEGRASI EKSTERNAL & WEBHOOK
# ------------------------------------------------------------------------------
# Webhook secret untuk komunikasi Firebase / n8n
FIREBASE_WEBHOOK_SECRET=ganti-dengan-token-rahasia-webhook-acak

# Firebase Auth - login email/NIK + password diproses di server (email tidak dikirim ke browser).
# FIREBASE_API_KEY: "Web API Key" dari Firebase Console > Project settings > General.
# Jika kosong, login password menampilkan pesan "layanan tidak tersedia".
FIREBASE_API_KEY=AIzaSy-ganti-dengan-web-api-key-firebase
FIREBASE_PROJECT_ID=nama-project-id-firebase
N8N_WEBHOOK_URL=http://localhost:5678/webhook/buku-tamu-routing
N8N_WEBHOOK_SECRET=token-rahasia-n8n
